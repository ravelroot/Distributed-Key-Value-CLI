# Configuração do nó lida pelo lemed.service. Troque os endereços pelos da máquina.
LEME_ID=no-1
LEME_CLUSTER=leme
LEME_ENDERECO=0.0.0.0:7400
LEME_ANUNCIAR=10.0.0.11:7400
LEME_ENTRAR=10.0.0.11:7400,10.0.0.12:7400,10.0.0.13:7400
LEME_DADOS=/var/lib/leme
LEME_REPLICAS=3
LEME_SINCRONIZAR=intervalo
LEME_METRICAS=0.0.0.0:9400
LEME_TOKEN_ARQUIVO=/etc/leme/token
# TLS e mTLS (descomente depois de gerar os certificados, veja o manual)
# LEME_TLS_CERT=/etc/leme/no.pem
# LEME_TLS_CHAVE=/etc/leme/no.key
# LEME_TLS_CA=/etc/leme/ca.pem
LEME_LOG=info
LEME_LOG_FORMATO=json
